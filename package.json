        "default": "./dist/registry.js"
      },
      "require": {
        "types": "./dist/registry/index.d.cts",
        "default": "./dist/registry.cjs"
      }
    },
    "./connectors": {
      "import": {
        "types": "./dist/connectors.d.ts",
        "default": "./dist/connectors.js"
      },
      "require": {
        "types": "./dist/connectors.d.cts",
        "default": "./dist/connectors.cjs"
      }
    },
