    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@particle-academy/fancy-auto-common": ">=0.1 <2.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@particle-academy/fancy-cms-ui": "^0.2.0",
    "@particle-academy/fancy-conformance": "^0.12.0",
    "@particle-academy/fancy-query": "^0.8.0",
    "@particle-academy/fancy-screens": "^0.4.3",
    "@particle-academy/react-fancy": "^5.17.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@xyflow/react": "^12.4.0",
    "ai": "^7.0.31",
    "clsx": "^2.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  },
  "publishConfig": {
